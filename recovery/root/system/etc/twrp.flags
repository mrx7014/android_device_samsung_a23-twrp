/system_image           emmc		/dev/block/mapper/system			    flags=backup=0;flashimg;display="System Image"
/vendor_image           emmc		/dev/block/mapper/vendor			    flags=backup=0;flashimg;display="Vendor Image"
/product_image          emmc		/dev/block/mapper/product			    flags=backup=0;flashimg;display="Product Image"
/system_ext_image       emmc		/dev/block/mapper/system_ext			    flags=backup=0;flashimg;display="System_EXT Image"

# partitions
/dev/block/by-name/userdata	/data	f2fs	noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678,inlinecrypt	latemount,wait,quota,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,
/dev/block/by-name/metadata	/metadata	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic,sync	wait,formattable,first_stage_mount,check
/boot			emmc		/dev/block/by-name/boot                  flags=backup=1;flashimg;display="Boot"
/recovery		emmc		/dev/block/by-name/recovery              flags=backup=1;flashimg;display="Recovery"
/cache			ext4		/dev/block/by-name/cache                 flags=backup=1;display="Cache"
/persist		ext4		/dev/block/by-name/persist               flags=display="Persist"
/sec_efs		ext4		/dev/block/by-name/sec_efs               flags=backup=1;display="SEC EFS"
/misc			emmc		/dev/block/by-name/misc
/dtbo			emmc		/dev/block/by-name/dtbo                  flags=backup=1;flashimg;display="Dtbo"
/optics_image           emmc		/dev/block/by-name/optics		 flags=backup=1;flashimg;display="Optics Image"
/prism_image            emmc		/dev/block/by-name/prism                 flags=backup=1;flashimg;display="Prism Image"
/vbmeta_system          emmc		/dev/block/by-name/vbmeta_system	 flags=backup=1;flashimg;display="Vbmeta_System"
/vbmeta_vendor          emmc            /dev/block/by-name/vbmeta_Vendor         flags=backup=1;flashimg;display="Vbmeta_Vendor"
/vbmeta                 emmc		/dev/block/by-name/vbmeta                flags=backup=1;flashimg;display="Vbmeta"

/external_sd            auto            /dev/block/mmcblk1p1  /dev/block/mmcblk1            flags=display="MicroSD";storage;wipeingui;removable
/usb_otg                auto            /dev/block/sda1       /dev/block/sda                flags=display="USB-Storage";storage;wipeingui;removable
